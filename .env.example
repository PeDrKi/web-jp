# Sao chép thành .env (KHÔNG đưa file .env lên GitHub). Bỏ trống DATABASE_URL để chạy thử local bằng PGlite.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=media
APP_SECRET=
SEED_ON_EMPTY=1
SEED_PASSWORD=
# Gửi email quên mật khẩu (Brevo) và đăng nhập Google - xem docs/08-dang-nhap-email-google.md
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=
GOOGLE_CLIENT_ID=
APP_URL=
